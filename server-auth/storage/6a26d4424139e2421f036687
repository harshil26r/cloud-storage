      "text": "Okay, as emphasized before, you **cannot and should not** call the Meta Conversions API directly from your client-side React application because it would expose your `ACCESS_TOKEN`.\n\nInstead, your React application will:\n1.  Collect event data.\n2.  Send this data to your own backend API.\n3.  Your backend API will then securely call the Meta Conversions API.\n\nHere\u0027s how you can structure it:\n\n**I. Backend API (Node.js with Express - Example)**\n\nFirst, you need a backend. If you don\u0027t have one, here\u0027s a simple Express.js server.\n\n1.  **Setup your Node.js backend project:**\n    ```bash\n    mkdir my-react-app-backend\n    cd my-react-app-backend\n    npm init -y\n    npm install express node-fetch crypto cors dotenv\n    ```\n    *   `express`: Web framework\n    *   `node-fetch`: For making HTTP requests to Meta (or use `axios`)\n    *   `crypto`: For hashing PII\n    *   `cors`: To allow requests from your React app (running on a different port during development)\n    *   `dotenv`: To manage environment variables (for `PIXEL_ID` and `ACCESS_TOKEN`)\n\n2.  **Create a `.env` file in `my-react-app-backend` directory:**\n    ```\n    META_PIXEL_ID\u003dYOUR_PIXEL_ID\n    META_ACCESS_TOKEN\u003dYOUR_ACCESS_TOKEN\n    # Optional: for testing CAPI events\n    # META_TEST_EVENT_CODE\u003dTESTXXXXX\n    ```\n    Replace with your actual Pixel ID and Access Token.\n\n3.  **Create `server.js` (or `index.js`):**\n    ```javascript\n    // my-react-app-backend/server.js\n    require(\u0027dotenv\u0027).config();\n    const express \u003d require(\u0027express\u0027);\n    const fetch \u003d require(\u0027node-fetch\u0027);\n    const crypto \u003d require(\u0027crypto\u0027);\n    const cors \u003d require(\u0027cors\u0027);\n\n    const app \u003d express();\n    const PORT \u003d process.env.PORT || 3001; // Backend runs on a different port\n\n    // --- Configuration ---\n    const PIXEL_ID \u003d process.env.META_PIXEL_ID;\n    const ACCESS_TOKEN \u003d process.env.META_ACCESS_TOKEN;\n    const TEST_EVENT_CODE \u003d process.env.META_TEST_EVENT_CODE; // Optional\n\n    if (!PIXEL_ID || !ACCESS_TOKEN) {\n        console.error(\"FATAL ERROR: META_PIXEL_ID or META_ACCESS_TOKEN is not set in .env file.\");\n        process.exit(1);\n    }\n\n    // --- Middleware ---\n    app.use(cors()); // Allow requests from your React frontend (e.g., http://localhost:3000)\n    app.use(express.json()); // To parse JSON request bodies\n\n    // --- Helper for Hashing ---\n    function sha256Hash(text) {\n        if (!text) return undefined;\n        return crypto.createHash(\u0027sha256\u0027).update(String(text).toLowerCase()).digest(\u0027hex\u0027);\n    }\n\n    // --- API Endpoint to receive events from React App ---\n    app.post(\u0027/api/track-meta-event\u0027, async (req, res) \u003d\u003e {\n        const { eventName, eventSourceUrl, userData, customData, eventId } \u003d req.body;\n\n        if (!eventName || !eventSourceUrl) {\n            return res.status(400).json({ error: \"eventName and eventSourceUrl are required.\" });\n        }\n\n        const eventTimeUnix \u003d Math.floor(Date.now() / 1000);\n        const clientIpAddress \u003d req.ip || req.headers[\u0027x-forwarded-for\u0027]?.split(\u0027,\u0027).shift() || req.socket?.remoteAddress;\n        const clientUserAgent \u003d req.headers[\u0027user-agent\u0027];\n\n        // Prepare user_data, ensuring PII is hashed\n        const preparedUserData \u003d {\n            em: userData?.email ? sha256Hash(userData.email) : undefined,\n            ph: userData?.phone ? sha256Hash(userData.phone) : undefined,\n            fn: userData?.firstName ? sha256Hash(userData.firstName) : undefined,\n            ln: userData?.lastName ? sha256Hash(userData.lastName) : undefined,\n            external_id: userData?.externalId ? sha256Hash(userData.externalId) : undefined, // Or send unhashed if it\u0027s not PII\n            client_ip_address: clientIpAddress,\n            client_user_agent: clientUserAgent,\n            fbp: userData?.fbp, // Pass through if client collected it\n            fbc: userData?.fbc, // Pass through if client collected it\n        };\n\n        // Remove undefined fields from preparedUserData\n        Object.keys(preparedUserData).forEach(key \u003d\u003e preparedUserData[key] \u003d\u003d\u003d undefined \u0026\u0026 delete preparedUserData[key]);\n\n\n        const metaEventData \u003d {\n            event_name: eventName,\n            event_time: eventTimeUnix,\n            action_source: \"website\",\n            event_source_url: eventSourceUrl,\n            event_id: eventId || `${eventName.toLowerCase().replace(/\\s+/g, \u0027_\u0027)}_${Date.now()}`, // Generate unique event_id if not provided\n            user_data: preparedUserData,\n            custom_data: customData || {},\n        };\n\n        const payload \u003d {\n            data: [metaEventData],\n        };\n\n        if (TEST_EVENT_CODE) {\n            payload.test_event_code \u003d TEST_EVENT_CODE;\n            console.log(\"Sending event with TEST_EVENT_CODE:\", TEST_EVENT_CODE);\n        }\n\n        const url \u003d `https://graph.facebook.com/v19.0/${PIXEL_ID}/events?access_token\u003d${ACCESS_TOKEN}`;\n\n        console.log(\"Sending to Meta:\", JSON.stringify(payload, null, 2));\n\n        try {\n            const metaResponse \u003d await fetch(url, {\n                method: \u0027POST\u0027,\n                headers: { \u0027Content-Type\u0027: \u0027application/json\u0027 },\n                body: JSON.stringify(payload)\n            });\n\n            const metaResponseData \u003d await metaResponse.json();\n\n            if (!metaResponse.ok) {\n                console.error(\"Meta API Error:\", metaResponseData);\n                return res.status(metaResponse.status).json({\n                    error: \"Failed to send event to Meta\",\n                    details: metaResponseData\n                });\n            }\n\n            console.log(\"Meta API Success:\", metaResponseData);\n            res.status(200).json({ success: true, message: \"Event tracked successfully\", metaResponse: metaResponseData });\n\n        } catch (error) {\n            console.error(\"Error calling Meta API:\", error);\n            res.status(500).json({ error: \"Internal server error while contacting Meta API\" });\n        }\n    });\n\n    app.listen(PORT, () \u003d\u003e {\n        console.log(`Backend server running on http://localhost:${PORT}`);\n        if (TEST_EVENT_CODE) {\n            console.log(`Meta CAPI Test Event Code is active: ${TEST_EVENT_CODE}`);\n        }\n    });\n    ```\n\n4.  **Run the backend:**\n    ```bash\n    node server.js\n    ```\n    It should start on `http://localhost:3001`.\n\n**II. React Frontend Application**\n\n1.  **Create or use an existing React project:**\n    ```bash\n    npx create-react-app my-react-app\n    cd my-react-app\n    # or using Vite:\n    # npm create vite@latest my-react-app -- --template react\n    # cd my-react-app\n    # npm install\n    ```\n\n2.  **Create a service/helper to send events to your backend:**\n    `(my-react-app/src/services/metaApiService.js)`\n    ```javascript\n    // src/services/metaApiService.js\n\n    // The URL of your backend endpoint\n    const BACKEND_API_URL \u003d process.env.REACT_APP_BACKEND_API_URL || \u0027http://localhost:3001/api/track-meta-event\u0027;\n\n    /**\n     * Sends an event to your backend, which then forwards it to Meta CAPI.\n     * @param {object} eventData\n     * @param {string} eventData.eventName - e.g., \"ViewContent\", \"AddToCart\", \"Purchase\"\n     * @param {string} eventData.eventSourceUrl - The URL where the event occurred (window.location.href)\n     * @param {object} [eventData.userData] - User-specific data.\n     * @param {string} [eventData.userData.email] - User\u0027s email (will be hashed by backend)\n     * @param {string} [eventData.userData.phone] - User\u0027s phone (will be hashed by backend)\n     * @param {string} [eventData.userData.firstName] - User\u0027s first name (will be hashed by backend)\n     * @param {string} [eventData.userData.lastName] - User\u0027s last name (will be hashed by backend)\n     * @param {string} [eventData.userData.externalId] - Your internal user ID\n     * @param {string} [eventData.userData.fbp] - _fbp cookie value, if available\n     * @param {string} [eventData.userData.fbc] - _fbc cookie value, if available (from URL after Meta ad click)\n     * @param {object} [eventData.customData] - Event-specific parameters (e.g., value, currency, content_ids)\n     * @param {string} [eventData.eventId] - Optional unique ID for the event (for deduplication)\n     * @returns {Promise\u003cobject\u003e} - The response from your backend\n     */\n    export const trackMetaEvent \u003d async (eventData) \u003d\u003e {\n        console.log(\"Sending event to backend:\", eventData);\n        try {\n            const response \u003d await fetch(BACKEND_API_URL, {\n                method: \u0027POST\u0027,\n                headers: {\n                    \u0027Content-Type\u0027: \u0027application/json\u0027,\n                },\n                body: JSON.stringify(eventData),\n            });\n\n            const responseData \u003d await response.json();\n\n            if (!response.ok) {\n                console.error(\u0027Backend Error:\u0027, responseData);\n                throw new Error(responseData.error || \u0027Failed to track event via backend\u0027);\n            }\n            console.log(\u0027Backend Success:\u0027, responseData);\n            return responseData;\n        } catch (error) {\n            console.error(\u0027Error sending event to backend:\u0027, error);\n            // You might want to implement more robust error handling or logging here\n            throw error;\n        }\n    };\n\n    // Helper to get _fbp and _fbc cookies (if they exist and are accessible to client-side JS)\n    // Note: HttpOnly cookies cannot be accessed by client-side JavaScript.\n    // _fbp is usually set by Meta Pixel JS. _fbc is set on landing page after ad click.\n    export const getMetaPixelCookie \u003d (name) \u003d\u003e {\n        const match \u003d document.cookie.match(new RegExp(\u0027(^| )\u0027 + name + \u0027\u003d([^;]+)\u0027));\n        if (match) return match[2];\n        return null;\n    };\n\n    export const getMetaClickIdFromUrl \u003d () \u003d\u003e {\n        const urlParams \u003d new URLSearchParams(window.location.search);\n        return urlParams.get(\u0027fbclid\u0027) || null; // _fbc value is often fbclid in URL\n    };\n    ```\n    *   Create a `.env` file in your React app\u0027s root (`my-react-app/.env`) if you want to configure `REACT_APP_BACKEND_API_URL`:\n        ```\n        REACT_APP_BACKEND_API_URL\u003dhttp://localhost:3001/api/track-meta-event\n        ```\n\n3.  **Example Usage in a React Component:**\n    `(my-react-app/src/App.js or any other component)`\n    ```jsx\n    // src/App.js\n    import React, { useEffect, useState } from \u0027react\u0027;\n    import \u0027./App.css\u0027;\n    import { trackMetaEvent, getMetaPixelCookie, getMetaClickIdFromUrl } from \u0027./services/metaApiService\u0027;\n\n    function App() {\n      const [message, setMessage] \u003d useState(\u0027\u0027);\n\n      // Example: Track PageView on component mount\n      useEffect(() \u003d\u003e {\n        const trackPageView \u003d async () \u003d\u003e {\n          try {\n            const fbp \u003d getMetaPixelCookie(\u0027_fbp\u0027);\n            const fbcParam \u003d getMetaClickIdFromUrl(); // Get fbclid from URL\n            // If fbc is in URL, it\u0027s the _fbc value. The Pixel usually saves it as a cookie.\n            // If you have Meta Pixel also running, it might set the _fbc cookie.\n            // This example prioritizes URL param if present.\n            const fbc \u003d fbcParam || getMetaPixelCookie(\u0027_fbc\u0027);\n\n            await trackMetaEvent({\n              eventName: \u0027PageView\u0027,\n              eventSourceUrl: window.location.href,\n              userData: {\n                fbp: fbp,\n                fbc: fbc\n              }\n            });\n            setMessage(\u0027PageView event tracked successfully!\u0027);\n          } catch (error) {\n            setMessage(`Error tracking PageView: ${error.message}`);\n          }\n        };\n        trackPageView();\n      }, []);\n\n      const handleViewProduct \u003d async () \u003d\u003e {\n        setMessage(\u0027Tracking ViewContent...\u0027);\n        try {\n          const fbp \u003d getMetaPixelCookie(\u0027_fbp\u0027);\n          const fbc \u003d getMetaClickIdFromUrl() || getMetaPixelCookie(\u0027_fbc\u0027);\n\n          await trackMetaEvent({\n            eventName: \u0027ViewContent\u0027,\n            eventSourceUrl: window.location.href + \u0027#product-123\u0027, // Example URL\n            userData: {\n              // Example: if user is logged in, you might have their email or ID\n              // email: \"testuser@example.com\", // Backend will hash this\n              // externalId: \"user_xyz789\",\n              fbp: fbp,\n              fbc: fbc\n            },\n            customData: {\n              content_name: \u0027Awesome T-Shirt\u0027,\n              content_category: \u0027Apparel\u0027,\n              content_ids: [\u0027SKU001\u0027],\n              content_type: \u0027product\u0027,\n              value: 25.99,\n              currency: \u0027USD\u0027,\n            },\n            eventId: `viewcontent_sku001_${Date.now()}` // Example unique event ID\n          });\n          setMessage(\u0027ViewContent event for \"Awesome T-Shirt\" tracked!\u0027);\n        } catch (error) {\n          setMessage(`Error tracking ViewContent: ${error.message}`);\n        }\n      };\n\n      const handleAddToCart \u003d async () \u003d\u003e {\n        