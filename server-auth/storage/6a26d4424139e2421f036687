-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\-\\n\u003d\\15000 // This list is for an array that\u0027s updated based on INFO level selection below\n    const selectedRows \u003d PIXEL_ID \u0026\u0026 PIXEL_ID_TEST_CODE_MAPPING[PIXEL_ID] ? PIXEL_ID_TEST_EVENT_CODE : undefined\n    // const eventData \u003d {\n    //   event_name: \u0027ViewContent\u0027,\n    //   event_time: Math.floor(Date.now() / 1000),\n    //   user_data: {\n    //     client_ip_address: \u0027127.0.0.1\u0027,\n    //     client_user_agent: window.navigator.userAgent\n    //   },\n    //   action_source: \u0027website\u0027,\n    //   event_source_url: window.location.href,\n    //   custom_data: {\n    //     currency: \u0027USD\u0027,\n    //     value: 123.45\n    //   }\n    // }\n\n    if (selectedRows \u0026\u0026 selectedRows.length \u003e 0) {\n      const data \u003d selectedRows.map((row) \u003d\u003e {\n        return {\n          event_name: row.event_name,\n          event_time: Math.floor(Date.now() / 1000),\n          event_source_url: window.location.href,\n          user_data: {\n            client_user_agent: window.navigator.userAgent\n          },\n          custom_data: row.custom_data,\n          action_source: \u0027website\u0027\n        }\n      })\n      const payload \u003d {\n        data,\n        test_event_code: selectedRows[0].test_code\n      }\n\n      // Call the fetch function\n      fetch(`https://graph.facebook.com/v18.0/${PIXEL_ID}/events?access_token\u003d${ACCESS_TOKEN}`, {\n        method: \u0027POST\u0027,\n        headers: {\n          \u0027Content-Type\u0027: \u0027application/json\u0027\n        },\n        body: JSON.stringify(payload)\n      })\n        .then((response) \u003d\u003e response.json())\n        .then((data) \u003d\u003e {\n          console.log(\u0027Success:\u0027, data)\n        })\n        .catch((error) \u003d\u003e {\n          console.error(\u0027Error:\u0027, error)\n        })\n    }\n  }\n  return (\n    \u003c\u003e\n      \u003cDataGrid rows\u003d{rows} columns\u003d{columns} checkboxSelection onRowSelectionModelChange\u003d{(newRowSelectionModel) \u003d\u003e {\n        setRowSelectionModel(newRowSelectionModel)\n        onAddClick(newRowSelectionModel)\n      }}\n      /\u003e\n    \u003c/\u003e\n  )\n}\n\nexport default EventDataTable\n```\n## Extremely Important Security Warning:\n\n**Calling the Meta Conversions API directly from frontend JavaScript (like React) is HIGHLY INSECURE and STRONGLY DISCOURAGED for any production or real-world application.**\n\n*   **Your `ACCESS_TOKEN` will be exposed:** It will be embedded directly in your site\u0027s JavaScript code, which is downloaded and viewable by anyone visiting your site using browser developer tools.\n*   **Consequences of an exposed `ACCESS_TOKEN`:**\n    *   **Data Corruption:** Anyone can find your token and use it to send false or spam events to your Pixel. This will severely corrupt your data, making your analytics, ad reporting, and optimization efforts useless.\n    *   **API Abuse:** Malicious actors could use your token to hit API rate limits, potentially blocking your legitimate events from being processed.\n    *   **No Server-Side Validation:** You lose the ability to validate or enrich data on a server before sending it to Meta.\n    *   **Inability to Send Sensitive Data Securely:** While you can hash PII (Personally Identifiable Information) on the client-side, the `ACCESS_TOKEN` itself is the master key.\n    *   **IP Address Inaccuracy:** The `client_ip_address` you can get from the frontend is unreliable. Meta will see the IP of the client making the request, but it\u0027s better to explicitly provide it, which is typically done on the server.\n\n**The secure and recommended method is ALWAYS to send event data from your frontend to your OWN backend server. Your backend server then securely makes the call to the Meta Conversions API using the `ACCESS_TOKEN` (which is stored securely on the server, never exposed to the client).**\n\n---\n\n**If you absolutely understand the severe risks and still need to do this for a very limited, non-production, experimental, or throwaway testing scenario (e.g., with a test Pixel ID and a token you can easily revoke), here\u0027s how you *could* do it in React.**\n\n**Again, DO NOT USE THIS IN PRODUCTION.**\n\n**Prerequisites:**\n\n1.  You have your `PIXEL_ID`.\n2.  You have your `ACCESS_TOKEN`.\n3.  You have a way to get the `test_event_code` if you are testing (from Events Manager \u003e Your Pixel \u003e Test Events).\n\n**Client-Side Hashing (Required for PII):**\n\nIf you need to send PII like email or phone numbers, Meta requires them to be SHA-256 hashed. You\u0027ll need a client-side hashing function. Modern browsers provide the `crypto.subtle` API.\n\n```javascript\n// Helper function for SHA-256 hashing in the browser\nasync function sha256Hash(text) {\n  if (!text) return null;\n  const encoder \u003d new TextEncoder();\n  const data \u003d encoder.encode(String(text).toLowerCase().trim()); // Normalize before hashing\n  const hashBuffer \u003d await crypto.subtle.digest(\u0027SHA-256\u0027, data);\n  const hashArray \u003d Array.from(new Uint8Array(hashBuffer));\n  const hashHex \u003d hashArray.map(b \u003d\u003e b.toString(16).padStart(2, \u00270\u0027)).join(\u0027\u0027);\n  return hashHex;\n}\n\n// Helper to get cookies (like _fbp)\nfunction getCookie(name) {\n  const match \u003d document.cookie.match(new RegExp(\u0027(^| )\u0027 + name + \u0027\u003d([^;]+)\u0027));\n  if (match) return match[2];\n  return null;\n}\n\n// Helper to get fbclid from URL\nfunction getFbclid() {\n  const urlParams \u003d new URLSearchParams(window.location.search);\n  return urlParams.get(\u0027fbclid\u0027);\n}\n```\n\n**React Component Example:**\n\n```jsx\nimport React, { useState, useEffect } from \u0027react\u0027;\n\n// --- CONFIGURATION (HIGHLY INSECURE TO STORE HERE IN PRODUCTION) ---\nconst PIXEL_ID \u003d \"YOUR_PIXEL_ID\"; // Replace with your Pixel ID\nconst ACCESS_TOKEN \u003d \"YOUR_ACCESS_TOKEN\"; // EXTREMELY SENSITIVE - DO NOT COMMIT\nconst TEST_EVENT_CODE \u003d \"YOUR_TEST_EVENT_CODE\"; // Optional: From Meta Events Manager \u003e Test Events\n\n// Helper function for SHA-256 hashing in the browser\nasync function sha256Hash(text) {\n  if (!text) return null;\n  const encoder \u003d new TextEncoder();\n  const data \u003d encoder.encode(String(text).toLowerCase().trim());\n  const hashBuffer \u003d await crypto.subtle.digest(\u0027SHA-256\u0027, data);\n  const hashArray \u003d Array.from(new Uint8Array(hashBuffer));\n  const hashHex \u003d hashArray.map(b \u003d\u003e b.toString(16).padStart(2, \u00270\u0027)).join(\u0027\u0027);\n  return hashHex;\n}\n\nfunction getCookie(name) {\n  const match \u003d document.cookie.match(new RegExp(\u0027(^| )\u0027 + name + \u0027\u003d([^;]+)\u0027));\n  if (match) return match[2];\n  return null;\n}\n\nfunction getFbclid() {\n  const urlParams \u003d new URLSearchParams(window.location.search);\n  return urlParams.get(\u0027fbclid\u0027);\n}\n\n\nfunction MetaEventSender() {\n  const [message, setMessage] \u003d useState(\u0027\u0027);\n  const [userEmail, setUserEmail] \u003d useState(\u0027\u0027); // Example for collecting PII\n\n  const sendCAPIEvent \u003d async (eventName, customData \u003d {}, userDataInput \u003d {}) \u003d\u003e {\n    if (!PIXEL_ID || !ACCESS_TOKEN) {\n      setMessage(\"Error: PIXEL_ID or ACCESS_TOKEN is not configured. THIS IS INSECURE.\");\n      console.error(\"Error: PIXEL_ID or ACCESS_TOKEN is not configured.\");\n      return;\n    }\n\n    setMessage(`Sending ${eventName} event...`);\n\n    const eventTimeUnix \u003d Math.floor(Date.now() / 1000);\n\n    // Prepare user_data\n    const userData \u003d {\n      // client_ip_address: \"CANNOT_RELIABLY_GET_CLIENT_IP_FROM_FRONTEND\", // Meta will use request IP\n      client_user_agent: navigator.userAgent,\n      fbp: getCookie(\u0027_fbp\u0027) || undefined,\n      fbc: getFbclid() || getCookie(\u0027_fbc\u0027) || undefined, // Prioritize fbclid from URL\n    };\n\n    if (userDataInput.email) {\n      userData.em \u003d await sha256Hash(userDataInput.email);\n    }\n    if (userDataInput.phone) {\n      userData.ph \u003d await sha256Hash(userDataInput.phone); // Add more PII fields as needed\n    }\n    // Add other hashed PII fields (fn, ln, etc.) similarly\n\n    // Remove undefined fields from userData to keep payload clean\n    Object.keys(userData).forEach(key \u003d\u003e userData[key] \u003d\u003d\u003d undefined \u0026\u0026 delete userData[key]);\n\n    const eventPayload \u003d {\n      event_name: eventName,\n      event_time: eventTimeUnix,\n      action_source: \"website\",\n      event_source_url: window.location.href,\n      user_data: userData,\n      custom_data: customData,\n      event_id: `${eventName.toLowerCase().replace(/\\s+/g, \u0027_\u0027)}_${Date.now()}` // Basic unique event ID\n    };\n\n    const finalPayload \u003d {\n      data: [eventPayload],\n    };\n\n    // Add test_event_code if provided (useful for debugging in Events Manager)\n    if (TEST_EVENT_CODE) {\n      finalPayload.test_event_code \u003d TEST_EVENT_CODE;\n    }\n\n    const url \u003d `https://graph.facebook.com/v19.0/${PIXEL_ID}/events?access_token\u003d${ACCESS_TOKEN}`;\n\n    try {\n      console.log(\"Sending CAPI payload directly from frontend:\", JSON.stringify(finalPayload, null, 2));\n      const response \u003d await fetch(url, {\n        method: \u0027POST\u0027,\n        headers: {\n          \u0027Content-Type\u0027: \u0027application/json\u0027,\n        },\n        body: JSON.stringify(finalPayload),\n      });\n\n      const responseData \u003d await response.json();\n\n      if (!response.ok) {\n        console.error(\"Meta API Error (Frontend Call):\", responseData);\n        setMessage(`Error sending ${eventName}: ${responseData.error?.message || \u0027Unknown error\u0027}`);\n        throw new Error(`HTTP error! status: ${response.status}, message: ${JSON.stringify(responseData)}`);\n      }\n\n      console.log(\"Meta API Success (Frontend Call):\", responseData);\n      setMessage(`${eventName} event sent successfully! Trace ID: ${responseData.trace_id || \u0027N/A\u0027}`);\n      return responseData;\n\n    } catch (error) {\n      console.error(\"Failed to send event directly to Meta API:\", error);\n      setMessage(`Failed to send ${eventName}: ${error.message}`);\n    }\n  };\n\n  const handleSendViewContent \u003d () \u003d\u003e {\n    sendCAPIEvent(\"ViewContent\", {\n      content_name: \"My Awesome Product Page\",\n      content_ids: [\"product123\"],\n      content_type: \"product\",\n      value: 19.99,\n      currency: \"USD\",\n    });\n  };\n\n  const handleSendPurchase \u003d async () \u003d\u003e {\n    // In a real scenario, this data would come from your app\u0027s state or forms\n    await sendCAPIEvent(\n      \"Purchase\",\n      { // custom_data\n        value: 99.99,\n        currency: \"USD\",\n        order_id: \"frontend_order_\" + Date.now(),\n        content_ids: [\"itemA\", \"itemB\"],\n        num_items: 2,\n      },\n      { // userDataInput (PII to be hashed)\n        email: userEmail || \"test@example.com\", // Example PII\n      }\n    );\n  };\n\n\n  return (\n    \u003cdiv\u003e\n      \u003ch2\u003eMeta CAPI Direct Frontend Sender (INSECURE - FOR TESTING ONLY)\u003c/h2\u003e\n      \u003cp style\u003d{{ color: \u0027red\u0027, fontWeight: \u0027bold\u0027 }}\u003e\n        WARNING: Using this method in production exposes your Access Token and is highly insecure.\n      \u003c/p\u003e\n\n      \u003cdiv\u003e\n        \u003clabel\u003e\n          User Email (for hashing):\n          \u003cinput\n            type\u003d\"email\"\n            value\u003d{userEmail}\n            onChange\u003d{(e) \u003d\u003e setUserEmail(e.target.value)}\n            placeholder\u003d\"user@example.com\"\n          /\u003e\n        \u003c/label\u003e\n      \u003c/div\u003e\n      \u003cbr /\u003e\n      \u003cbutton onClick\u003d{handleSendViewContent}\u003eSend \"ViewContent\" Event\u003c/button\u003e\n      \u003cbr /\u003e\u003cbr /\u003e\n      \u003cbutton onClick\u003d{handleSendPurchase}\u003eSend \"Purchase\" Event\u003c/button\u003e\n      \u003cbr /\u003e\u003cbr /\u003e\n      {message \u0026\u0026 \u003cp\u003eStatus: {message}\u003c/p\u003e}\n      \u003cp\u003e\n        Check your browser\u0027s console and Meta Events Manager (Test Events tab if `TEST_EVENT_CODE` is set).\n      \u003c/p\u003e\n    \u003c/div\u003e\n  );\n}\n\nexport default MetaEventSender;\n```\n\n**To use this (again, with extreme caution):**\n\n1.  Replace `YOUR_PIXEL_ID`, `YOUR_ACCESS_TOKEN`, and optionally `YOUR_TEST_EVENT_CODE`.\n2.  Integrate this `MetaEventSender` component into your React application.\n3.  When you click the buttons, it will attempt to send the event directly to Meta. Check your browser\u0027s console for logs and errors. If you\u0027re using a `TEST_EVENT_CODE`, check the \"Test Events\" tab in your Pixel\u0027s Events Manager.\n\n**Key Parameters Used in the Example:**\n\n*   **`PIXEL_ID`**: In the URL.\n*   **`ACCESS_TOKEN`**: In the URL. **THIS IS THE SECURITY RISK.**\n*   **`event_name`**: e.g., \"ViewContent\", \"Purchase\".\n*   **`event_time`**: Unix timestamp generated client-side.\n*   **`action_source`**: \"website\".\n*   **`event_source_url`**: `window.location.href`.\n*   **`user_data`**:\n    *   `em`: Hashed email (client-side hashing used).\n    *   `client_user_agent`: From `navigator.userAgent`.\n    *   `fbp`, `fbc`: Attempted to be read from cookies/URL.\n    *   **Note:** `client_ip_address` is difficult to reliably get from the client. Meta will use the IP of the incoming request.\n*   **`custom_data`**: For event-specific details like value, currency, product IDs.\n*   **`event_id`**: A basic unique ID generated client-side.\n*   **`test_event_code`**: If provided, helps with debugging in Meta\u0027s interface.\n\n**Final Strong Recommendation:**\n\nPlease reconsider this approach for anything beyond temporary, isolated testing with non-critical data. The standard and secure method is to use a backend proxy. The risks of exposing your `ACCESS_TOKEN` are significant.",
